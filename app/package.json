    "migrate:dry-run": "node scripts/migrate.mjs --dry-run"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "2.1.2",
    "@elevenlabs/client": "^1.28.0",
    "@supabase/supabase-js": "2.118.0",
    "@telnyx/webrtc": "2.27.10",
    "@twilio/voice-sdk": "^2.18.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "motion": "^13.4.4",
    "next": "16.3.8",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "6.1.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
