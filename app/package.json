{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit -p .",
    "guide:gen": "node --experimental-strip-types tools/gen-agent-guide.ts",
    "guide:check": "node --experimental-strip-types tools/gen-agent-guide.ts --check",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "migrate:dry-run": "node scripts/migrate.mjs --dry-run",
    "bug-signals": "node scripts/bug-signals.mjs"
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "2.1.2",
    "@elevenlabs/client": "^1.25.0",
    "@supabase/supabase-js": "2.112.3",
    "@telnyx/webrtc": "2.27.10",
    "@twilio/voice-sdk": "^2.18.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "motion": "^13.4.4",
    "next": "16.4.2",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vinext": "1.4.3",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2"
    },
    "patchedDependencies": {
      "@elevenlabs/client@1.25.0": "patches/@elevenlabs__client@1.25.0.patch"
    }
  }
}
