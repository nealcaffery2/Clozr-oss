NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SITE_URL=https://your-clozr-site.example.com
# Optional: hCaptcha site key. When set, sign-up, sign-in, magic-link and reset
# forms solve a captcha and pass the token to Supabase Auth. Turn on hCaptcha
# under Authentication → Attack protection in the Supabase dashboard as well,
# with the matching secret, or the token is ignored.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
